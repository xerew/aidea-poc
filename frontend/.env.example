VITE_API_URL=http://localhost:8000/api

# Web analytics (optional, cookieless). Leave VITE_ANALYTICS_PROVIDER unset to
# disable entirely. Pick one provider and fill in its settings.
#
# Plausible:
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_PLAUSIBLE_DOMAIN=aidea-hub.eu
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js   # or your self-hosted URL
#
# Matomo (self-hosted):
# VITE_ANALYTICS_PROVIDER=matomo
# VITE_MATOMO_URL=https://analytics.aidea-hub.eu/
# VITE_MATOMO_SITE_ID=1
