# Caddyfile — production reverse proxy

# Redirect www → apex so both addresses work (Caddy still gets a cert for www).
www.{$DOMAIN:localhost} {
    redir https://{$DOMAIN:localhost}{uri} permanent
}

{$DOMAIN:localhost} {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }
    handle /static/* {
        root * /srv
        file_server
    }
    handle /media/* {
        root * /srv
        file_server
    }
    handle {
        reverse_proxy frontend:80
    }
}
